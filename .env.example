NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=featureflags
DB_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Guards POST /api/v1/tenants (which mints API keys). Leave empty for local development
# and CI — the guard is a no-op when unset. Terraform generates a value and injects it
# from Secret Manager in staging and production, where the service is publicly reachable.
# Read the deployed value with:
#   gcloud secrets versions access latest --secret=feature-flag-service-production-admin-api-key
ADMIN_API_KEY=

# Per-tenant rate limit (noisy-neighbour containment). Defaults to 6000 requests per
# 60s window — roughly 100 rps sustained per tenant. Lower it to exercise 429 handling.
THROTTLE_LIMIT=6000
THROTTLE_TTL_MS=60000

GCP_PROJECT_ID=your-gcp-project
